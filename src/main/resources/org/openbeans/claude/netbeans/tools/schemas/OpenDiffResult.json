{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "Content.json"
      }
    },
    "isError": {
      "type": "boolean",
      "description": "Set when the diff could not be shown"
    }
  },
  "required": ["content"]
}